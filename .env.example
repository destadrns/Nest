# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://sff_user:sff_password@localhost:5432/sff_dev

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change-me-to-a-random-64-char-hex-string-in-production-please
SESSION_MAX_AGE=86400000
SESSION_IDLE_TIMEOUT=7200000

# Argon2id
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=900000

# MFA
MFA_ISSUER=NEST

# WebAuthn
WEBAUTHN_RP_NAME=NEST
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
